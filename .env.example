# =============================================================================
# REVIVE — Local Development Configuration
# =============================================================================
# Copy this file to .env before running. Do NOT commit the .env file.
# All values below are non-secret local-only defaults.

# -- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=revive
POSTGRES_USER=revive
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# -- Redis --------------------------------------------------------------------
REDIS_PORT=6379

# -- Service Ports ------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -- Backend Application ------------------------------------------------------
# Used when running the backend directly (outside Docker Compose).
# Docker Compose injects service-hosted equivalents automatically.
DATABASE_URL=postgresql+psycopg://revive:change-me-for-local-development@localhost:5432/revive
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# -- Razorpay (Phase 3+) -----------------------------------------------------
# DO NOT fill these with real credentials. They are placeholders for future
# Razorpay integration. Real values go in .env only, which is gitignored.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
